{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simula.local/schemas/feedback_result.schema.json",
  "title": "Feedback keseluruhan (AI-CONTEXT 6.3 dan 6.5)",
  "description": "Bentuk sama dengan IReviewFeedback di client/src/types/result.ts. Masing-masing 1-3 poin, satu kalimat per poin.",
  "type": "object",
  "additionalProperties": false,
  "required": ["strengths", "improvements", "nextSteps"],
  "properties": {
    "strengths": { "$ref": "#/$defs/points" },
    "improvements": { "$ref": "#/$defs/points" },
    "nextSteps": { "$ref": "#/$defs/points" }
  },
  "$defs": {
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string", "maxLength": 300 }
    }
  }
}
