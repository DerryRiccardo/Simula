# Salin ke .env lalu isi nilainya. Jangan commit .env.

# server | worker | all
APP_MODE=all
# development | production
APP_ENV=development
LOG_LEVEL=debug
# json | console
LOG_FORMAT=console

PORT=8080
FRONTEND_URL=http://localhost:3000
BODY_LIMIT_BYTES=1048576
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
SHUTDOWN_TIMEOUT=20s
# Pisahkan dengan koma bila server berada di belakang proxy/load balancer.
TRUSTED_PROXIES=

# Aplikasi: pooler Supabase mode transaction (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Migrasi: koneksi langsung atau pooler mode session (port 5432).
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_SLOW_QUERY=500ms

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

QUEUE_NAME=simula-queue
WORKER_CONCURRENCY=5

HEALTH_CHECK_TIMEOUT=2s
