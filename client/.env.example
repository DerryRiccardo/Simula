# URL publik website (dipakai untuk metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL API backend Go. Saat mock aktif, service membaca data tiruan dari src/mocks.
NEXT_PUBLIC_API_URL=/api/v1

# 'enabled' = pakai data tiruan tanpa backend. Kosongkan saat backend Go sudah siap.
NEXT_PUBLIC_API_MOCKING=enabled
