# URL publik website (dipakai untuk metadata, sitemap, robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL API backend Go. Lokal: http://localhost:8080/api. Saat mock aktif, layanan yang
# masih tiruan membaca data dari src/mocks.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# 'enabled' = pakai data tiruan tanpa backend. Kosongkan bila semua layanan sudah memakai backend.
NEXT_PUBLIC_API_MOCKING=enabled

# Mode campuran: layanan yang sudah memakai backend walau mock aktif, dipisah koma.
# Contoh: auth
NEXT_PUBLIC_API_REAL_SERVICES=
